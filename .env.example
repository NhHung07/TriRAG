# Sao chép thành .env và điền khoá của CHÍNH BẠN (mỗi thành viên dùng key riêng).
GEMINI_API_KEY=

# Model chấm điểm (LLM-as-a-judge) — nên khác model sinh. Bất kỳ API tương thích OpenAI
# (OpenAI, Groq, OpenRouter, Ollama...). Để trống nếu chưa dùng.
JUDGE_API_KEY=
JUDGE_BASE_URL=

# Cache BPE của tiktoken (để chạy offline sau lần tải đầu tiên)
TIKTOKEN_CACHE_DIR=.cache/tiktoken
# Cache model HuggingFace
HF_HOME=.cache/huggingface
